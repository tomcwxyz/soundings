# Copy to .env (git-ignored). For dev, any password works.
POSTGRES_PASSWORD=changeme-locally

# Soundings runtime
SOUNDINGS_LOG_LEVEL=info
SOUNDINGS_ENV=dev

# Public origin used for canonical tags, the sitemap and Open Graph URLs.
# The Astro Node adapter builds request URLs from the socket it binds to,
# not the forwarded Host header, so behind a reverse proxy it sees
# http://localhost and cannot infer the public hostname. Leave unset for
# local dev; set it to the public origin on any deployed instance.
# Usually the same value as SOUNDINGS_UI_ORIGIN, but kept separate: that
# one is the server's CORS allowlist, this one is what we publish to
# crawlers and social scrapers.
# SOUNDINGS_PUBLIC_SITE_URL=https://soundings.example.org

# Full 360Giving grant index. Default is weekly Monday 05:30 UTC because the
# GrantNav export is several hundred MB. Set a standard 5-field cron expression
# here if a deployment needs a different freshness/cost trade-off.
# SOUNDINGS_GRANT_INDEX_REFRESH_CRON="30 5 * * 1"

# Adapter API keys
# CHARITY_COMMISSION_API_KEY=  # parked for future detail enrichment; bulk loader doesn't need it
# STATXPLORE_API_KEY=          # DWP Stat-Xplore; required for live Stat-Xplore tests
# NOMIS_API_KEY=               # ONS Nomis (MYE / Census / APS); optional, raises rate limit
